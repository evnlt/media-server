# Copy to .env and fill in. The single admin account is created/updated from these on startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Codec uploads are converted to: H264 (plays on every device) or Av1 (smaller files, much slower to
# encode, and older phones/browsers may not be able to play it). Quality settings (Crf, Preset, MaxHeight)
# live under "Transcode" in appsettings.json.
TRANSCODE_CODEC=H264
